module Rx_tb;

    // 파라미터 설정
    parameter CLK_FREQ    = 100_000_000;
    parameter BAUD_RATE   = 9600;
    parameter CLK_PERIOD  = 10;
    parameter BIT_PERIOD  = 1_000_000_000 / BAUD_RATE;

    // 테스트벤치 신호 선언
    reg           clk;
    reg           rst_n;
    reg           rx_in;
    wire  [7:0]   rx_data;
    wire          rx_done;

    // DUT (Device Under Test) 인스턴스화
    Rx #(
        .CLK_FREQ(CLK_FREQ),
        .BAUD_RATE(BAUD_RATE)
    ) dut (
        .i_clk(clk),
        .i_rst_n(rst_n),
        .i_rx_in(rx_in),
        .o_rx_data(rx_data),
        .o_rx_done(rx_done)
    );

    // 클럭 생성
    always begin
        clk = 1'b0;
        #(CLK_PERIOD / 2);
        clk = 1'b1;
        #(CLK_PERIOD / 2);
    end

    // 데이터 전송 태스크
    task uart_transmit_byte;
        input [7:0] data_to_send;
        integer i;
        begin
            // Start Bit (low)
            rx_in = 1'b0;
            #(BIT_PERIOD);

            // Data Bits (LSB first)
            for (i = 0; i < 8; i = i + 1) begin
                rx_in = data_to_send[i];
                #(BIT_PERIOD);
            end

            // Stop Bit (high)
            rx_in = 1'b1;
            #(BIT_PERIOD);
        end
    endtask

    // 시뮬레이션 시나리오
    initial begin
        // 초기화
        rst_n = 1'b0;
        rx_in = 1'b1;
        #20;
        rst_n = 1'b1;
        #100;

        $display("---------------------------------");
        $display("UART RX Testbench Start");
        
        uart_transmit_byte(8'h41); // 'A' 전송
        wait (rx_done);
        $display("[%0t] Received: 0x%h", $time, rx_data);

        #1000;

        uart_transmit_byte(8'hAA); // 0xAA 전송
        wait (rx_done);
        $display("[%0t] Received: 0x%h", $time, rx_data);

        $display("---------------------------------");
        $display("Test Finished.");
        $finish;
    end

endmodule
