module Rx #(
    parameter CLK_FREQ = 100_000_000,
    parameter BAUD_RATE = 9600
) (
    input  wire           i_clk,
    input  wire           i_rst_n,
    input  wire           i_rx_in,
    output wire [7:0]     o_rx_data,
    output wire           o_rx_done
);

    localparam CLKS_PER_BIT = CLK_FREQ / BAUD_RATE;

    // FSM 상태 정의
    localparam [2:0] IDLE        = 3'b000;
    localparam [2:0] START_BIT   = 3'b001;
    localparam [2:0] DATA_BITS   = 3'b010;
    localparam [2:0] STOP_BIT    = 3'b011;
    localparam [2:0] CLEANUP     = 3'b100;

    // 내부 신호 선언
    reg [2:0]     current_state, next_state;
    reg [7:0]     rx_data_reg;
    reg [3:0]     bit_index;
    reg [$clog2(CLKS_PER_BIT)-1:0] clk_counter;
    reg           rx_done_pulse;

    // FSM의 상태를 저장하는 순차 로직 (Sequential Logic)
    always @(posedge i_clk or negedge i_rst_n) begin
        if (!i_rst_n) begin
            current_state <= IDLE;
            clk_counter   <= 0;
            bit_index     <= 0;
            rx_data_reg   <= 8'h00;
        end else begin
            current_state <= next_state;

            if (current_state == IDLE) begin
                clk_counter <= 0;
            end else if (clk_counter >= CLKS_PER_BIT - 1) begin
                clk_counter <= 0;
            end else begin
                clk_counter <= clk_counter + 1;
            end

            if (current_state == DATA_BITS && clk_counter == (CLKS_PER_BIT / 2)) begin
                rx_data_reg[bit_index] <= i_rx_in;
                if (bit_index == 7) begin
                    bit_index <= 0;
                end else begin
                    bit_index <= bit_index + 1;
                end
            end
        end
    end

    // FSM의 다음 상태를 결정하는 조합 로직 (Combinational Logic)
    always @(*) begin
        next_state    = current_state;
        rx_done_pulse = 1'b0;

        case (current_state)
            IDLE: begin
                if (i_rx_in == 1'b0) begin
                    next_state = START_BIT;
                end
            end

            START_BIT: begin
                if (clk_counter == (CLKS_PER_BIT / 2)) begin
                    if (i_rx_in == 1'b0) begin
                        next_state = DATA_BITS;
                    end else begin
                        next_state = IDLE;
                    end
                end
            end

            DATA_BITS: begin
                if (bit_index == 7 && clk_counter == (CLKS_PER_BIT / 2)) begin
                    next_state = STOP_BIT;
                end
            end

            STOP_BIT: begin
                if (clk_counter == (CLKS_PER_BIT / 2)) begin
                    if (i_rx_in == 1'b1) begin
                        next_state = CLEANUP;
                    end else begin
                        next_state = IDLE;
                    end
                end
            end

            CLEANUP: begin
                rx_done_pulse = 1'b1;
                next_state    = IDLE;
            end

            default: begin
                next_state = IDLE;
            end
        endcase
    end
    
    // 최종 출력 로직
    assign o_rx_data = rx_data_reg;
    assign o_rx_done = rx_done_pulse;

endmodule
