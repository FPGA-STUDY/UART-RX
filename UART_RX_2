`timescale 1ns / 1ps

//수정본 -> 핸드셰이크  사용
module Rx #(
    parameter CLK_FREQ = 100_000_000,
    parameter BAUD_RATE = 9600
) (
    // 1. 포트 이름 변경 및 핸드셰이크 포트 추가
    input  wire           clk_i,
    input  wire           rst_i,
    input  wire           serial_data_i,
    input  wire           ready_i,          // (From Tx) "전송 가능" 신호
    output reg  [7:0]     parallel_data_o,
    output reg            valid_o           // (To Tx) "데이터 유효" 신호
);

    localparam CLKS_PER_BIT = CLK_FREQ / BAUD_RATE;

    // 4. FSM 상태 변경: CLEANUP -> DATA_VALID
    localparam [2:0] IDLE        = 3'b000;
    localparam [2:0] START_BIT   = 3'b001;
    localparam [2:0] DATA_BITS   = 3'b010;
    localparam [2:0] STOP_BIT    = 3'b011;
    localparam [2:0] DATA_VALID  = 3'b100; // 수신 완료 및 Tx 대기 상태

    // 내부 신호 선언
    reg [2:0]     current_state, next_state;
    reg [7:0]     rx_data_reg;
    reg [3:0]     bit_index;
    reg [$clog2(CLKS_PER_BIT)-1:0] clk_counter;

    // FSM 순차 로직 (상태 저장)
    always @(posedge clk_i or posedge rst_i) begin
        // 2. Active-High 리셋으로 변경
        if (rst_i) begin
            current_state   <= IDLE;
            clk_counter     <= 0;
            bit_index       <= 0;
            rx_data_reg     <= 8'h00;
            parallel_data_o <= 8'h00;
            valid_o         <= 1'b0;
        end else begin
            current_state <= next_state;

            // 클럭 카운터 로직
            if (current_state == IDLE) begin
                clk_counter <= 0;
            end else if (clk_counter >= CLKS_PER_BIT - 1) begin
                clk_counter <= 0;
            end else begin
                clk_counter <= clk_counter + 1;
            end

            // 데이터 샘플링 로직
            if (current_state == DATA_BITS && clk_counter == (CLKS_PER_BIT / 2)) begin
                rx_data_reg[bit_index] <= serial_data_i;
                if (bit_index == 7) begin
                    bit_index <= 0;
                end else begin
                    bit_index <= bit_index + 1;
                end
            end
            
            // 데이터 출력 및 valid 신호 제어
            if (next_state == DATA_VALID) begin
                parallel_data_o <= rx_data_reg;
                valid_o <= 1'b1;
            end else if (current_state == DATA_VALID && ready_i) begin
                valid_o <= 1'b0;
            end
        end
    end

    // FSM 조합 로직 (다음 상태 결정)
    always @(*) begin
        next_state = current_state;

        case (current_state)
            IDLE: begin
                if (serial_data_i == 1'b0) begin
                    next_state = START_BIT;
                end
            end

            START_BIT: begin
                if (clk_counter == (CLKS_PER_BIT / 2)) begin
                    if (serial_data_i == 1'b0) begin
                        next_state = DATA_BITS;
                    end else begin
                        next_state = IDLE;
                    end
                end
            end

            DATA_BITS: begin
                if (bit_index == 7 && clk_counter == (CLKS_PER_BIT / 2)) begin
                    next_state = STOP_BIT;
                end
            end

            STOP_BIT: begin
                if (clk_counter == (CLKS_PER_BIT / 2)) begin
                    if (serial_data_i == 1'b1) begin
                        next_state = DATA_VALID; // 성공 시 DATA_VALID 상태로 이동
                    end else begin
                        next_state = IDLE;
                    end
                end
            end
            
            DATA_VALID: begin
                // ready_i가 1이면(Tx가 준비되면) IDLE로 돌아감
                if (ready_i) begin
                    next_state = IDLE;
                end
            end

            default: begin
                next_state = IDLE;
            end
        endcase
    end
endmodule
